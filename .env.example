# JARVIS development environment (CI/dev only).
#
# Real API keys and secrets are NEVER stored here: `jarvis init` stores them in
# the Windows Credential Manager via the `keyring` package. This file documents
# the environment variables JARVIS reads. Do not commit a real `.env`.

# Override the JARVIS data directory (used by tests and benchmarks).
# Default: %LOCALAPPDATA%\jarvis
#JARVIS_DATA_DIR=C:\Users\you\AppData\Local\jarvis

# Log level: DEBUG | INFO | WARNING | ERROR
#JARVIS_LOG_LEVEL=DEBUG

# Dry-run mode: tools describe what they would do and execute nothing.
#JARVIS_DRY_RUN=1

# LLM model names. Do NOT guess from memory: they change.
# Pick current models from the provider docs (see docs/12_DEPENDENCY_VERIFICATION.md)
# and set them here or in config.toml ([llm] section).
#JARVIS_LLM__PLANNER_MODEL=
#JARVIS_LLM__FAST_MODEL=
#JARVIS_LLM__VISION_MODEL=